# AutoShield environment template.
#
# THIS FILE IS COMMITTED AND MUST STAY SECRET-FREE. Copy it to `.env` (which is
# gitignored) and fill values in there, or better, export them in your shell so
# no key ever touches the filesystem at all.
#
# Use a DEDICATED testnet account for everything below. Never a key that
# controls anything of value, on any chain.

# Deployment key for `frontend/scripts/deploy-testnet.mjs`.
# 0x + 64 hex characters. Required for Testnet Bradbury and Testnet Asimov;
# StudioNet and localnet are gasless and need no funded account.
# Fund it at https://testnet-faucet.genlayer.foundation/ (Cloudflare-gated, so
# it must be claimed manually in a browser; 100 GEN per address per 24h).
TESTNET_PRIVATE_KEY=

# Used by gltest when running the Python test suites against Testnet Bradbury.
# Leave blank for localnet and StudioNet.
ACCOUNT_PRIVATE_KEY_1=

# Optional: run the evaluator against a real model during integration tests.
# Without these, tests install deterministic responses over sim_installMocks
# and no key is required. See docs/ARCHITECTURE.md, "Consensus Verification".
# AUTOSHIELD_LLM_PROVIDER=openai:gpt-4o-mini
# OPENAI_API_KEY=
