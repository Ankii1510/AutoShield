# AutoShield console configuration.
#
# NOTHING SECRET BELONGS IN THIS FILE, OR IN .env.local. Every NEXT_PUBLIC_*
# value is compiled into the browser bundle and is world-readable. Never put a
# private key or an API key here. Deployment keys live in the shell environment
# and are read only by scripts/deploy-testnet.mjs (see ../.env.example).

# Which GenLayer network the console talks to. This is the NETWORK NAME, not a
# chain id, and that distinction is load-bearing: testnet-bradbury and
# testnet-asimov BOTH report chain 4221, and studionet reports 61999, which is
# also the id scripts/glsim.sh runs the local node on. Selecting by id would
# silently pick the wrong network -- and the wrong consensus contract with it.
#
#   studio-next  chain 61997, consensus v0.6 -- REQUIRED for the hackathon
#   studio-dev   chain 61997, the same network under the SDK's own hostname
#   localnet     chain 61999 via glsim, consensus v0.5
#   studionet | testnet-bradbury | testnet-asimov   consensus v0.5
#
# Each network is pinned to the SDK generation that speaks its protocol:
# v0.6 networks use genlayer-js 2.x, v0.5 networks use the 1.x alias. A v2
# client cannot talk to a v0.5 node at all, so this is not a preference.
NEXT_PUBLIC_GENLAYER_NETWORK=localnet

# LOCALNET ONLY. For a public network the endpoint and chain id come from the
# named network itself and these two are ignored, so that no environment file
# can silently repoint the console at a different chain.
NEXT_PUBLIC_GENLAYER_RPC=http://127.0.0.1:4000/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999

# Deployed contract addresses -- public information.
#   local:   npm run deploy:local   -- --operator 0xYourWalletAddress
#   testnet: npm run deploy:testnet -- --network testnet-bradbury --operator 0xYourWalletAddress
# Either script writes these into frontend/.env.local for you.
NEXT_PUBLIC_PROTOCOL_ADDRESS=
NEXT_PUBLIC_AUTOSHIELD_ADDRESS=
